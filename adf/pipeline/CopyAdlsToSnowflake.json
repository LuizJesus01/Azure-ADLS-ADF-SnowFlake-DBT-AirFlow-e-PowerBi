							"type": "LinkedServiceReference"
						},
						"path": "projetos/ProjetoSnowFlake/Staging"
					},
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "product_category_name",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "PRODUCT_CATEGORY_NAME",
									"type": "String",
									"physicalType": "VARCHAR"
								}
							},
							{
								"source": {
									"name": "product_category_name_english",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "PRODUCT_CATEGORY_NAME_ENGLISH",
									"type": "String",
