				}
			},
			{
				"name": "Validate Raw Load",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "All Copies Completed",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SnowflakeV2Source",
						"query": "SELECT\n    (SELECT COUNT(*) FROM OLIST.RAW.CUSTOMERS) AS CUSTOMERS,\n    (SELECT COUNT(*) FROM OLIST.RAW.GEOLOCATION) AS GEOLOCATION,\n    (SELECT COUNT(*) FROM OLIST.RAW.ORDER_ITEMS) AS ORDER_ITEMS,\n    (SELECT COUNT(*) FROM OLIST.RAW.ORDERS) AS ORDERS,\n    (SELECT COUNT(*) FROM OLIST.RAW.PAYMENTS) AS PAYMENTS,\n    (SELECT COUNT(*) FROM OLIST.RAW.PRODUCTS) AS PRODUCTS,\n    (SELECT COUNT(*) FROM OLIST.RAW.REVIEWS) AS REVIEWS,\n    (SELECT COUNT(*) FROM OLIST.RAW.SELLERS) AS SELLERS,\n    (SELECT COUNT(*) FROM OLIST.RAW.CATEGORY_TRANSLATION) AS CATEGORY_TRANSLATION;",
						"exportSettings": {
							"type": "SnowflakeExportCopyCommand"
						},
						"treatDecimalAsString": false
					},
					"dataset": {
						"referenceName": "Snf_validation",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Check Raw Validation",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Validate Raw Load",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(\n    greater(activity('Validate Raw Load').output.firstRow.CUSTOMERS, 0),\n    and(\n        greater(activity('Validate Raw Load').output.firstRow.GEOLOCATION, 0),\n        and(\n            greater(activity('Validate Raw Load').output.firstRow.ORDER_ITEMS, 0),\n            and(\n                greater(activity('Validate Raw Load').output.firstRow.ORDERS, 0),\n                and(\n                    greater(activity('Validate Raw Load').output.firstRow.PAYMENTS, 0),\n                    and(\n                        greater(activity('Validate Raw Load').output.firstRow.PRODUCTS, 0),\n                        and(\n                            greater(activity('Validate Raw Load').output.firstRow.REVIEWS, 0),\n                            and(\n                                greater(activity('Validate Raw Load').output.firstRow.SELLERS, 0),\n                                greater(activity('Validate Raw Load').output.firstRow.CATEGORY_TRANSLATION, 0)\n                            )\n                        )\n                    )\n                )\n            )\n        )\n    )\n)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Raw Validation Failed",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "One or more RAW tables are empty after ingestion.",
								"errorCode": "RAW_VALIDATION_FAILED"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Raw Validation Passed",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					]
				}
			}
		],
		"annotations": []
